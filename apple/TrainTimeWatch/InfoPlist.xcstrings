    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TrainTime braucht deinen Standort, um Stationen in der Nähe zu finden und Live-Abfahrten zu zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TrainTime needs your location to find nearby Swiss train stations and show live departures."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TrainTime a besoin de votre position pour trouver les gares proches et afficher les départs en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TrainTime ha bisogno della tua posizione per trovare le stazioni vicine e mostrare le partenze live."
          }
        }
      }
    }
  },
  "version": "1.0"
