          }
        }
      }
    },
    "This trip is already underway or finished": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Reise läuft bereits oder ist vorbei"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce trajet est déjà en cours ou terminé"
