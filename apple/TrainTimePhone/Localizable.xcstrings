    },
    "Track on watch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Uhr verfolgen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre sur la montre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui sull'orologio"
          }
        }
      }
    },
    "Track on your phone and a departure mirrors to a paired watch, which also reads the phone's location, handy indoors. The watch icon turns green when it's live.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge am Handy und die Abfahrt spiegelt sich auf eine gekoppelte Uhr, die auch den Handy-Standort nutzt, praktisch drinnen. Das Uhr-Symbol wird grün, wenn es live ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez sur le téléphone et le départ se reflète sur une montre appairée, qui lit aussi la position du téléphone, pratique en intérieur. L'icône montre devient verte quand c'est en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui sul telefono e la partenza si riflette su un orologio abbinato, che legge anche la posizione del telefono, utile al chiuso. L'icona orologio diventa verde quando è live."
          }
        }
      }
    },
    "Tracking on watch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgt auf der Uhr"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivi sur la montre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguito sull'orologio"
          }
        }
      }
    },
    "Tracking on watch · %@": {
      "localizations": {
        "de": {
