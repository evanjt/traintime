    "Train": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zug"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Train"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Treno"
          }
        }
      }
    },
    "TrainTime collects your location to time your route reminder, even when the app is closed or not in use. You can decline, and we'll use your last known location instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TrainTime erfasst deinen Standort, um deine Routen-Erinnerung zu timen, auch wenn die App geschlossen ist. Du kannst ablehnen, dann verwenden wir deinen letzten bekannten Standort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TrainTime relève votre position pour caler votre rappel d'itinéraire, même app fermée ou inutilisée. Vous pouvez refuser, nous utiliserons alors votre dernière position connue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TrainTime rileva la tua posizione per calibrare il promemoria del percorso, anche ad app chiusa o inutilizzata. Puoi rifiutare: useremo l'ultima posizione nota."
          }
        }
      }
    },
    "Trains, buses, trams": {
      "localizations": {
