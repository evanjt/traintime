          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il percorso per %@ sarà dimenticato."
          }
        }
      }
    },
    "This SBB link format isn't supported yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses SBB-Linkformat wird noch nicht unterstützt"
