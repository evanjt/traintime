        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez une ligne vers la droite, ou maintenez-la, pour la mettre en favori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri una linea a destra, o tienila premuta, per salvarla nei preferiti."
          }
        }
      }
    },
    "Swiss border outline from Natural Earth, 1:10m resolution, public domain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schweizer Grenzumriss von Natural Earth, Auflösung 1:10m, gemeinfrei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contour de la Suisse de Natural Earth, résolution 1:10m, domaine public."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confine svizzero da Natural Earth, risoluzione 1:10m, pubblico dominio."
          }
        }
      }
    },
    "Switch what you see with the mode chips. Each mode has its own nearby stops.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle die Ansicht mit den Modus-Chips. Jeder Modus hat eigene Haltestellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez de vue avec les puces de mode. Chaque mode a ses propres arrêts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia vista con i selettori di modo. Ogni modo ha le sue fermate."
          }
        }
      }
    },
    "Syncs live": {
