          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà un itinéraire enregistré. Le remplacer par le trajet vers %@ ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già un percorso salvato. Sostituirlo con il viaggio per %@?"
          }
        }
      }
    },
    "You'll be notified %lld min before departure": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst %lld min vor Abfahrt erinnert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez notifié %lld min avant le départ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarai avvisato %lld min prima della partenza"
          }
        }
      }
    },
    "You'll be notified in %lld min": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst in %lld min erinnert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez notifié dans %lld min"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarai avvisato tra %lld min"
          }
        }
      }
    },
    "You'll be notified your walk time + %lld min before departure": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst Gehzeit + %lld min vor Abfahrt erinnert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez notifié votre temps de marche + %lld min avant le départ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarai avvisato il tuo tempo a piedi + %lld min prima della partenza"
          }
        }
      }
    },
    "Your location and the departure time update live to tell you if you'll make it on foot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort und die Abfahrtszeit aktualisieren sich live und zeigen, ob du es zu Fuss schaffst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position et l'heure de départ se mettent à jour en direct et vous disent si vous l'aurez à pied."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua posizione e l'orario di partenza si aggiornano live e ti dicono se ce la fai a piedi."
          }
        }
      }
    },
    "Your trip opens here, tracked and ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Reise öffnet sich hier, verfolgt und bereit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre trajet s'ouvre ici, suivi et prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo viaggio si apre qui, seguito e pronto."
          }
        }
      }
    },
