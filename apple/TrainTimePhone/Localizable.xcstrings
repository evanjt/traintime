          "stringUnit": {
            "state": "translated",
            "value": "Live-Abfahrten von Open Transport Data Switzerland, betrieben von den Schweizerischen Bundesbahnen (SBB), über die OJP-API."
          }
        },
        "fr": {
          "stringUnit": {
