default_platform(:ios)

platform :ios do
  desc "Sync certificates and provisioning profiles via Match"
  lane :certificates do
    if ENV["ASC_KEY_ID"]
      api_key = app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_API_KEY"],
        is_key_content_base64: true
      )
      # Ensure App IDs exist
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)

      app_ids = {
        "com.evanjt.traintime" => "TrainTime",
        "com.evanjt.traintime.watchkitapp" => "TrainTime WatchKit",
        "com.evanjt.traintime.widget" => "TrainTime Widget"
      }
      app_ids.each do |bundle_id, name|
        existing = Spaceship::ConnectAPI::BundleId.find(bundle_id)
        unless existing
          UI.message("Creating App ID: #{bundle_id}")
          Spaceship::ConnectAPI::BundleId.create(
            name: name,
            identifier: bundle_id,
            platform: "IOS"
          )
          UI.success("Created App ID: #{bundle_id}")
        end
      end
      # Regenerate profiles after an App ID capability change (such as the App
      # Group), since match reuses the stale profile that lacks the entitlement.
      match(
        type: "appstore",
        api_key: api_key,
        force: ENV["MATCH_FORCE"] == "true",
        app_identifier: ["com.evanjt.traintime", "com.evanjt.traintime.watchkitapp", "com.evanjt.traintime.widget"]
      )
    else
      match(
        type: "appstore",
        readonly: true,
        app_identifier: ["com.evanjt.traintime", "com.evanjt.traintime.watchkitapp", "com.evanjt.traintime.widget"]
      )
    end
  end

  desc "Build release IPA (iOS app + embedded watchOS + widget)"
  lane :build_release do
    project_root = File.expand_path("..", __dir__)
    xcodeproj = File.join(project_root, "TrainTimeWatch.xcodeproj")
    team_id = ENV["FASTLANE_TEAM_ID"]

    # Configure signing for all targets
    {
      "TrainTimePhone" => "match AppStore com.evanjt.traintime",
      "TrainTimeWatch" => "match AppStore com.evanjt.traintime.watchkitapp",
      "TrainTimeWidgetExtension" => "match AppStore com.evanjt.traintime.widget"
    }.each do |target, profile|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: xcodeproj,
        team_id: team_id,
        profile_name: profile,
        code_sign_identity: "Apple Distribution",
        targets: [target]
      )
    end

    FileUtils.mkdir_p("artifacts")

    # Build iOS app (watchOS companion embeds automatically)
    build_app(
      project: xcodeproj,
      scheme: "TrainTimePhone",
      configuration: "Release",
      destination: "generic/platform=iOS",
      output_directory: "artifacts",
      output_name: "traintime.ipa",
      clean: true,
      include_bitcode: false,
      buildlog_path: "artifacts",
      export_method: "app-store",
      export_team_id: team_id,
      xcargs: 'OTHER_CODE_SIGN_FLAGS="--timestamp=none"'
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("IPA not created") unless ipa_path && File.exist?(ipa_path)

    # Post-process: patch embedded watch app for App Store validation
    # Xcode's actool doesn't generate Long Look icons that Apple requires for
    # companion watch apps. Workaround: set DTSDKName to watchos4.3 to bypass
    # the Series 4 icon validation, and inject loose icon PNGs into the bundle.
    patch_dir = File.join("artifacts", "ipa_patch")
    FileUtils.rm_rf(patch_dir)
    sh("unzip", "-q", ipa_path, "-d", patch_dir)

    watch_app = Dir["#{patch_dir}/Payload/*.app/Watch/*.app"].first
    if watch_app
      UI.message("Patching embedded watch app: #{watch_app}")
      watch_plist = File.join(watch_app, "Info.plist")

      # Bypass Series 4 icon validation
      sh("/usr/libexec/PlistBuddy", "-c", "Set :DTSDKName watchos4.3", watch_plist)
      sh("/usr/libexec/PlistBuddy", "-c", "Set :DTPlatformVersion 4.3", watch_plist)

      # Generate loose icon PNGs from the 1024px source
      source_icon = File.join(project_root, "TrainTimeWatch", "Assets.xcassets", "AppIcon.appiconset", "AppIcon-1024.png")
      if File.exist?(source_icon)
        {
          "AppIcon24x24@2x.png" => 48, "AppIcon27.5x27.5@2x.png" => 55,
          "AppIcon29x29@2x.png" => 58, "AppIcon29x29@3x.png" => 87,
          "AppIcon33x33@2x.png" => 66, "AppIcon40x40@2x.png" => 80,
          "AppIcon44x44@2x.png" => 88, "AppIcon46x46@2x.png" => 92,
          "AppIcon50x50@2x.png" => 100, "AppIcon51x51@2x.png" => 102,
          "AppIcon86x86@2x.png" => 172, "AppIcon98x98@2x.png" => 196,
          "AppIcon108x108@2x.png" => 216, "AppIcon117x117@2x.png" => 234,
          "AppIcon129x129@2x.png" => 258, "AppIcon1024x1024.png" => 1024
        }.each do |name, px|
          sh("sips", "-z", px.to_s, px.to_s, source_icon, "--out", File.join(watch_app, name))
        end
        UI.success("Injected #{16} loose icon PNGs into watch app bundle")
      end

      # Add icon plist entries
      sh("/usr/libexec/PlistBuddy", "-c", "Delete :CFBundleIconName", watch_plist) rescue nil
      sh("/usr/libexec/PlistBuddy", "-c", "Add :CFBundleIconName string AppIcon", watch_plist)
      begin; sh("/usr/libexec/PlistBuddy", "-c", "Delete :CFBundleIcons:CFBundlePrimaryIcon:CFBundleIconFiles", watch_plist); rescue; end
      sh("/usr/libexec/PlistBuddy", "-c", "Add :CFBundleIcons dict", watch_plist) rescue nil
      sh("/usr/libexec/PlistBuddy", "-c", "Add :CFBundleIcons:CFBundlePrimaryIcon dict", watch_plist) rescue nil
      sh("/usr/libexec/PlistBuddy", "-c", "Add :CFBundleIcons:CFBundlePrimaryIcon:CFBundleIconFiles array", watch_plist) rescue nil
      %w[AppIcon24x24 AppIcon27.5x27.5 AppIcon29x29 AppIcon33x33 AppIcon40x40
         AppIcon44x44 AppIcon46x46 AppIcon50x50 AppIcon51x51
         AppIcon86x86 AppIcon98x98 AppIcon108x108 AppIcon117x117 AppIcon129x129].each_with_index do |name, i|
        sh("/usr/libexec/PlistBuddy", "-c", "Add :CFBundleIcons:CFBundlePrimaryIcon:CFBundleIconFiles:#{i} string #{name}", watch_plist)
      end

      # Re-sign everything inside-out after modification
      # 1. Watch app (modified)
      sh("codesign", "--force", "--sign", "Apple Distribution", "--preserve-metadata=identifier,entitlements", watch_app)

      # 2. Widget extension (unchanged but parent sig is invalidated)
      widget_ext = Dir["#{patch_dir}/Payload/*.app/PlugIns/*.appex"].first
      if widget_ext
        sh("codesign", "--force", "--sign", "Apple Distribution", "--preserve-metadata=identifier,entitlements", widget_ext)
      end

      # 3. Parent iOS app
      ios_app = Dir["#{patch_dir}/Payload/*.app"].first
      sh("codesign", "--force", "--sign", "Apple Distribution", "--preserve-metadata=identifier,entitlements", ios_app) if ios_app

      # Re-create IPA
      FileUtils.rm(ipa_path)
      Dir.chdir(patch_dir) { sh("zip", "-qr", File.expand_path(ipa_path), "Payload") }
      UI.success("Patched IPA with watch icons")
    else
      UI.important("No embedded watch app found in IPA, skipping icon patch")
    end
    FileUtils.rm_rf(patch_dir)

    # Rename to traintime.ipa for consistent artifact naming
    final_path = File.join("artifacts", "traintime.ipa")
    FileUtils.mv(ipa_path, final_path) unless ipa_path == final_path
    UI.success("Created IPA: #{final_path} (#{File.size(final_path)} bytes)")
  end

  desc "Build watchOS-only release IPA (legacy stub method)"
  lane :build_watch_only do
    project_root = File.expand_path("..", __dir__)
    xcodeproj = File.join(project_root, "TrainTimeWatch.xcodeproj")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: xcodeproj,
      team_id: ENV["FASTLANE_TEAM_ID"],
      profile_name: "match AppStore com.evanjt.traintime",
      code_sign_identity: "Apple Distribution",
      targets: ["TrainTimeWatch"]
    )

    FileUtils.mkdir_p("artifacts")

    build_app(
      project: xcodeproj,
      scheme: "TrainTimeWatch",
      configuration: "Release",
      destination: "generic/platform=watchOS",
      skip_package_ipa: true,
      output_directory: "artifacts",
      clean: true,
      include_bitcode: false,
      buildlog_path: "artifacts",
      xcargs: 'OTHER_CODE_SIGN_FLAGS="--timestamp=none"'
    )
  end

  desc "Upload to TestFlight (internal track)"
  lane :beta do |options|
    ipa_path = options[:ipa] || "artifacts/traintime.ipa"

    UI.user_error!("No IPA file specified. Use ipa:<path>") unless ipa_path
    UI.user_error!("IPA file not found: #{ipa_path}") unless File.exist?(ipa_path)

    UI.message("Uploading #{ipa_path} to TestFlight...")

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Submit to App Store Review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Create/refresh the App Store version and upload metadata (no review submission)"
  lane :sync_metadata do |options|
    version = options[:version] || UI.user_error!("Pass the App Store version, e.g. version:1.2.3")

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    deliver(
      api_key: api_key,
      app_version: version,
      metadata_path: File.expand_path("metadata", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
