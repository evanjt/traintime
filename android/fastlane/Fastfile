default_platform(:android)

# Build and ship TrainTime to Google Play. Signing comes from
# android/keystore.properties or the KEYSTORE_* env vars (see app/build.gradle.kts).
# The Play service-account JSON is referenced by the Appfile via SUPPLY_JSON_KEY.
# Track names must match those configured in the Play Console
# (internal | alpha = closed | beta = open | production).
platform :android do
  # supply uploads changelogs/<versionCode>.txt as the "What's new" text. A missing
  # file uploads empty release notes silently, so fail loudly when one is absent.
  # Checks both the phone (:app) and watch (:wear) versionCodes.
  # Returns the versionCode read from the app module.
  private_lane :require_changelogs do
    codes = ["app", "wear"].map do |mod|
      code = File.read(File.expand_path("../#{mod}/build.gradle.kts", __dir__))[/versionCode\s*=\s*(\d+)/, 1]
      UI.user_error!("Could not read versionCode from #{mod}/build.gradle.kts") if code.nil?
      code
    end
    Dir[File.expand_path("metadata/android/*/changelogs", __dir__)].sort.each do |dir|
      locale = File.basename(File.dirname(dir))
      codes.each do |code|
        changelog = File.join(dir, "#{code}.txt")
        UI.user_error!("Missing release notes: metadata/android/#{locale}/changelogs/#{code}.txt") unless File.exist?(changelog)
      end
    end
    codes.first
  end

  desc "Tag release: publish to internal testing, stage the same build as a draft in open testing"
  lane :ci_release do |options|
    aab_path = options[:aab] ||
      File.expand_path("../app/build/outputs/bundle/release/app-release.aab", __dir__)
    wear_aab_path = options[:wear_aab] ||
      File.expand_path("../wear/build/outputs/bundle/release/wear-release.aab", __dir__)
    [aab_path, wear_aab_path].each do |path|
      UI.user_error!("AAB not found: #{path}. Run `fastlane build` first.") unless File.exist?(path)
    end

    mapping_path = options[:mapping]
    if mapping_path.nil?
      default_mapping = File.expand_path("../app/build/outputs/mapping/release/mapping.txt", __dir__)
      mapping_path = default_mapping if File.exist?(default_mapping)
    end

    version_code = require_changelogs.to_i

    # 1. Publish immediately to internal testing, uploading both AABs (phone + Wear OS)
    #    in one edit + release notes. supply attaches the mapping to every versionCode
    #    in the edit; harmless for :wear, which is unminified.
    supply(
      track: "internal",
      aab_paths: [aab_path, wear_aab_path],
      mapping: mapping_path,
      release_status: "completed",
      metadata_path: File.expand_path("metadata/android", __dir__),
      # Feature graphic + phone/wear screenshots ship from metadata/android/
      # <locale>/images/, mirrored there by docs/screenshots/board.py --install.
      # Uploads replace the whole per-locale set; the repo is the source of truth.
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )

    # 2. Stage the same build in open (beta) testing as a draft, for manual review
    #    before going live to open testers. Release notes travel with the promotion.
    supply(
      track: "internal",
      track_promote_to: "beta",
      track_promote_release_status: "draft",
      version_code: version_code,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Build a signed release AAB (gradle bundleRelease)"
  lane :build do
    gradle(
      project_dir: File.expand_path("..", __dir__),
      task: "bundle",
      build_type: "Release",
    )
  end

  desc "Upload AABs to a Play track. Options: track:<name> aab:<path> wear_aab:<path> mapping:<path>"
  lane :deploy do |options|
    track = options[:track] || "internal"
    aab_path = options[:aab] ||
      File.expand_path("../app/build/outputs/bundle/release/app-release.aab", __dir__)
    wear_aab_path = options[:wear_aab] ||
      File.expand_path("../wear/build/outputs/bundle/release/wear-release.aab", __dir__)

    mapping_path = options[:mapping]
    if mapping_path.nil?
      default_mapping = File.expand_path("../app/build/outputs/mapping/release/mapping.txt", __dir__)
      mapping_path = default_mapping if File.exist?(default_mapping)
    end

    [aab_path, wear_aab_path].each do |path|
      UI.user_error!("AAB not found: #{path}. Run `fastlane build` first.") unless File.exist?(path)
    end
    require_changelogs
    UI.message("Uploading #{aab_path} + #{wear_aab_path} to #{track} track")

    supply(
      track: track,
      aab_paths: [aab_path, wear_aab_path],
      mapping: mapping_path,
      metadata_path: File.expand_path("metadata/android", __dir__),
      skip_upload_images: false,
      skip_upload_screenshots: false,
      release_status: "completed",
    )
  end

  desc "Promote the latest internal build to the closed (alpha) track"
  lane :promote_to_closed do
    supply(
      track: "internal",
      track_promote_to: "alpha",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Promote the closed (alpha) track to production (10% staged rollout)"
  lane :promote_to_production do
    supply(
      track: "alpha",
      track_promote_to: "production",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      rollout: "0.1",
    )
  end

  desc "Upload store metadata only, no binary"
  lane :metadata do
    supply(
      metadata_path: File.expand_path("metadata/android", __dir__),
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
