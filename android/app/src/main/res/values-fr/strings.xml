    <string name="tour_nearby_title">Les départs autour de vous</string>
    <string name="tour_nearby_body">Les arrêts les plus proches et leurs départs en direct. Ici : Bern Bahnhof.</string>
    <string name="tour_modes_title">Trains, bus, trams</string>
    <string name="tour_modes_body">Changez de vue avec les puces de mode. Chaque mode a ses propres arrêts.</string>
    <string name="tour_track_title">Suivre un départ</string>
    <string name="tour_track_body">Touchez un départ pour le suivre.</string>
    <string name="tour_tracking_extra">Votre position et l\'heure de départ se mettent à jour en direct et vous disent si vous l\'aurez à pied.</string>
    <string name="tour_star_title">Vos lignes en favori</string>
    <string name="tour_star_body">Glissez une ligne vers la droite, ou maintenez-la, pour la mettre en favori.</string>
    <string name="tour_starred_extra">Elle se place au-dessus de la ligne dorée et reste dans la liste en dessous.</string>
    <string name="tour_pin_title">Épingler une gare</string>
    <string name="tour_pin_body">Les gares épinglées mènent la liste dès qu\'elles sont parmi les cinq plus proches. Votre gare reste en tête.</string>
    <string name="tour_mode_title">Choisir le mode par défaut</string>
    <string name="tour_mode_body">Choisissez le mode que vous prenez le plus. TrainTime s\'ouvre dessus.</string>
    <string name="tour_sbb_title">Vos trajets depuis l\'app CFF</string>
    <string name="tour_sbb_body">Vous partagez un trajet depuis Mobile CFF ? Envoyez-le à TrainTime et il reprend votre train.</string>
    <string name="tour_routes_title">Itinéraires enregistrés et rappels</string>
    <string name="tour_routes_body">Les trajets plus tardifs attendent comme itinéraire enregistré. Ouvrez-le pour voir chaque étape, choisir les correspondances à suivre et recevoir un rappel avant le départ, calé sur votre marche si vous l\'activez.</string>
    <string name="tour_watch_title">Emportez-le au poignet</string>
    <string name="tour_watch_body">Wear OS et Garmin se synchronisent en direct : suivez sur le téléphone et envoyez un départ à votre poignet. Il y a aussi une app Apple Watch pour iPhone.</string>
    <string name="tour_widget_title">Ajouter le widget</string>
    <string name="tour_widget_body">Vos prochains départs sur l\'écran d\'accueil.</string>
    <string name="tour_replay_snackbar">Vous pouvez revoir la visite à tout moment dans les réglages.</string>

