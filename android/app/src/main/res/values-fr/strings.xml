    <!-- Dialogs -->
    <string name="bg_track_title">Suivre en arrière-plan ?</string>
    <string name="bg_track_body">TrainTime relève votre position pour caler votre rappel d\'itinéraire, même app fermée ou inutilisée. Vous pouvez refuser, nous utiliserons alors votre dernière position connue.</string>
    <string name="continue_label">Continuer</string>
    <string name="bg_denied_title">Dernière position utilisée</string>
    <string name="bg_denied_body">Aucun souci. Votre rappel fonctionne toujours, avec votre dernière position connue au lieu du direct. Autorisez l\'accès permanent à tout moment pour le rendre live.</string>
    <string name="open_settings">Ouvrir les réglages</string>
