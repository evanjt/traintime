    <!-- Dialogs -->
    <string name="bg_track_title">Track in the background?</string>
    <string name="bg_track_body">TrainTime collects your location to time your route reminder, even when the app is closed or not in use. You can decline, and we\'ll use your last known location instead.</string>
    <string name="continue_label">Continue</string>
    <string name="bg_denied_title">Using your last location</string>
    <string name="bg_denied_body">That\'s fine. Your reminder still works, using your last known location instead of live updates. Allow all-time access any time to make it live.</string>
    <string name="open_settings">Open settings</string>
    <string name="keep_as_is">Keep as is</string>
    <string name="review_body">A quick rating helps other commuters find the app.</string>
    <string name="replace_route_title">Replace queued route?</string>
    <string name="replace_route_body_fmt">You already have a route saved. Replace it with the trip to %1$s?</string>
    <string name="replace">Replace</string>
    <string name="keep_existing">Keep existing</string>

