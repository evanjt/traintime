    <!-- Dialogs -->
    <string name="bg_track_title">Im Hintergrund verfolgen?</string>
    <string name="bg_track_body">TrainTime erfasst deinen Standort, um deine Routen-Erinnerung zu timen, auch wenn die App geschlossen ist. Du kannst ablehnen, dann verwenden wir deinen letzten bekannten Standort.</string>
    <string name="continue_label">Weiter</string>
    <string name="bg_denied_title">Letzter Standort wird verwendet</string>
    <string name="bg_denied_body">Kein Problem. Deine Erinnerung funktioniert weiter, mit dem letzten bekannten Standort statt Live-Updates. Erlaube den Zugriff jederzeit, um sie live zu machen.</string>
    <string name="open_settings">Einstellungen öffnen</string>
    <string name="keep_as_is">So lassen</string>
    <string name="review_body">Eine kurze Bewertung hilft anderen Pendlern, die App zu finden.</string>
    <string name="replace_route_title">Gespeicherte Route ersetzen?</string>
    <string name="replace_route_body_fmt">Du hast schon eine Route gespeichert. Durch die Reise nach %1$s ersetzen?</string>
    <string name="replace">Ersetzen</string>
    <string name="keep_existing">Behalten</string>

