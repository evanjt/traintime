<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded tracking notification content. Room for the detail line to wrap
     and a taller bar. The full "Stop tracking" button is the system action row
     that DecoratedCustomViewStyle draws below this content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <Chronometer
            android:id="@+id/notif_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Time" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

    <ImageView
        android:id="@+id/notif_bar"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
</LinearLayout>
