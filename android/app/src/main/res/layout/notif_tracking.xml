<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed tracking notification content (inside DecoratedCustomViewStyle).
     Height is capped (~56dp), so this is the compact glance: title, live
     countdown, an obvious chip-styled Stop button, the detail line and the
     bar. The full-width "Stop tracking" action button lives in the expanded
     view via the system action row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <Chronometer
            android:id="@+id/notif_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Time" />

        <TextView
            android:id="@+id/notif_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/notif_stop_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

    <ImageView
        android:id="@+id/notif_bar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="1dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
</LinearLayout>
