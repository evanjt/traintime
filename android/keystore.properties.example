# Copy to android/keystore.properties (gitignored) and fill in.
# Generate the upload keystore once, then keep it backed up safely:
#   keytool -genkeypair -v -keystore upload-keystore.jks \
#     -alias traintime -keyalg RSA -keysize 2048 -validity 9125
# storeFile is resolved relative to the android/ directory.
storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=traintime
keyPassword=CHANGE_ME
