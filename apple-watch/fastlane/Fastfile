default_platform(:ios)

platform :ios do
  desc "Sync certificates and provisioning profiles via Match"
  lane :certificates do
    if ENV["ASC_KEY_ID"]
      api_key = app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_API_KEY"],
        is_key_content_base64: true
      )
      match(type: "appstore", api_key: api_key)
    else
      match(type: "appstore", readonly: true)
    end
  end

  desc "Build release IPA for watchOS"
  lane :build_release do
    project_root = File.expand_path("..", __dir__)
    xcodeproj = File.join(project_root, "TrainTimeWatch.xcodeproj")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: xcodeproj,
      team_id: ENV["FASTLANE_TEAM_ID"],
      profile_name: "match AppStore com.evanjt.traintime",
      code_sign_identity: "Apple Distribution"
    )

    FileUtils.mkdir_p("artifacts")

    # Archive only — Xcode 26 bug: "App Store Connect" export method missing for watchOS standalone apps
    # https://developer.apple.com/forums/thread/817223
    build_app(
      project: xcodeproj,
      scheme: "TrainTimeWatch",
      configuration: "Release",
      destination: "generic/platform=watchOS",
      skip_package_ipa: true,
      output_directory: "artifacts",
      clean: true,
      include_bitcode: false,
      buildlog_path: "artifacts",
      xcargs: 'OTHER_CODE_SIGN_FLAGS="--timestamp=none"'
    )

    # Manually package IPA from the signed archive (bypassing xcodebuild -exportArchive)
    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    app_path = Dir["#{archive_path}/Products/Applications/*.app"].first
    UI.user_error!("No .app found in archive") unless app_path

    ipa_path = File.expand_path(File.join("artifacts", "traintime.ipa"))
    Dir.mktmpdir do |tmpdir|
      payload = File.join(tmpdir, "Payload")
      FileUtils.mkdir_p(payload)
      FileUtils.cp_r(app_path, payload)
      sh("bash", "-c", "cd '#{tmpdir}' && zip -r -q '#{ipa_path}' Payload")
    end

    UI.user_error!("IPA not created at #{ipa_path}") unless File.exist?(ipa_path)
    UI.success("Created IPA: #{ipa_path} (#{File.size(ipa_path)} bytes)")
  end

  desc "Upload to TestFlight (internal track)"
  lane :beta do |options|
    ipa_path = options[:ipa] || "artifacts/traintime.ipa"

    UI.user_error!("No IPA file specified. Use ipa:<path>") unless ipa_path
    UI.user_error!("IPA file not found: #{ipa_path}") unless File.exist?(ipa_path)

    UI.message("Uploading #{ipa_path} to TestFlight...")

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    # Override platform detection — altool can't handle "watchos" platform from standalone
    # watchOS IPAs. Apple treats standalone watchOS apps as iOS in App Store Connect.
    require "fastlane_core/ipa_file_analyser"
    FastlaneCore::IpaFileAnalyser.define_singleton_method(:fetch_app_platform) { |_path| "ios" }

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      app_platform: "ios",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Submit to App Store Review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
