default_platform(:ios)

platform :ios do
  desc "Sync certificates and provisioning profiles via Match"
  lane :certificates do
    if ENV["ASC_KEY_ID"]
      api_key = app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_API_KEY"],
        is_key_content_base64: true
      )
      # Ensure .watchkitapp App ID exists (needed for iOS stub wrapper)
      watch_id = "com.evanjt.traintime.watchkitapp"
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
      existing = Spaceship::ConnectAPI::BundleId.find(watch_id)
      unless existing
        UI.message("Creating App ID: #{watch_id}")
        Spaceship::ConnectAPI::BundleId.create(
          name: "TrainTime WatchKit",
          identifier: watch_id,
          platform: "IOS"
        )
        UI.success("Created App ID: #{watch_id}")
      end
      match(type: "appstore", api_key: api_key)
    else
      match(type: "appstore", readonly: true)
    end
  end

  desc "Build release IPA for watchOS"
  lane :build_release do
    project_root = File.expand_path("..", __dir__)
    xcodeproj = File.join(project_root, "TrainTimeWatch.xcodeproj")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: xcodeproj,
      team_id: ENV["FASTLANE_TEAM_ID"],
      profile_name: "match AppStore com.evanjt.traintime",
      code_sign_identity: "Apple Distribution"
    )

    FileUtils.mkdir_p("artifacts")

    # Archive
    build_app(
      project: xcodeproj,
      scheme: "TrainTimeWatch",
      configuration: "Release",
      destination: "generic/platform=watchOS",
      skip_package_ipa: true,
      output_directory: "artifacts",
      clean: true,
      include_bitcode: false,
      buildlog_path: "artifacts",
      xcargs: 'OTHER_CODE_SIGN_FLAGS="--timestamp=none"'
    )

    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    ipa_path = File.expand_path(File.join("artifacts", "traintime.ipa"))

    # Try xcodebuild -exportArchive (creates proper IPA with iOS stub wrapper)
    # Falls back to manual packaging if Xcode 26 bug affects CLI too
    # https://developer.apple.com/forums/thread/817223
    begin
      export_options_path = File.join(project_root, "ExportOptions.plist")
      File.write(export_options_path, <<~PLIST)
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
          <key>method</key>
          <string>app-store-connect</string>
          <key>destination</key>
          <string>export</string>
          <key>teamID</key>
          <string>#{ENV["FASTLANE_TEAM_ID"]}</string>
          <key>signingStyle</key>
          <string>manual</string>
          <key>provisioningProfiles</key>
          <dict>
            <key>com.evanjt.traintime</key>
            <string>match AppStore com.evanjt.traintime</string>
          </dict>
          <key>manageAppVersionAndBuildNumber</key>
          <false/>
        </dict>
        </plist>
      PLIST

      export_dir = File.join(project_root, "export_output")
      sh("xcodebuild", "-exportArchive",
         "-archivePath", archive_path,
         "-exportOptionsPlist", export_options_path,
         "-exportPath", export_dir)

      exported_ipa = Dir["#{export_dir}/*.ipa"].first
      if exported_ipa
        FileUtils.cp(exported_ipa, ipa_path)
        UI.success("Created IPA via xcodebuild -exportArchive: #{ipa_path}")
      else
        raise "No IPA found in export output"
      end
    rescue => e
      UI.important("xcodebuild -exportArchive failed (#{e.message}), constructing iOS stub wrapper")

      # Xcode 26 bug: app-store-connect export method missing for standalone watchOS apps
      # Workaround: manually construct the iOS stub wrapper that xcodebuild normally creates
      # The IPA must contain an iOS stub app with the watchOS app nested in Watch/
      # See: bazelbuild/rules_apple, Apple Developer Forums thread/817223

      watch_app_path = Dir["#{archive_path}/Products/Applications/*.app"].first
      UI.user_error!("No .app found in archive") unless watch_app_path

      watch_plist = File.join(watch_app_path, "Info.plist")
      bundle_id = sh("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleIdentifier", watch_plist).strip
      bundle_version = sh("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleVersion", watch_plist).strip
      short_version = sh("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleShortVersionString", watch_plist).strip
      app_name = File.basename(watch_app_path, ".app")
      team_id = ENV["FASTLANE_TEAM_ID"]
      # Nested watch app CFBundleIdentifier must "properly extend" the iOS stub's
      watch_bundle_id = "#{bundle_id}.watchkitapp"

      Dir.mktmpdir do |tmpdir|
        ios_app_dir = File.join(tmpdir, "Payload", "#{app_name}.app")
        FileUtils.mkdir_p(ios_app_dir)

        # 1. Compile minimal iOS stub binary
        stub_src = File.join(tmpdir, "stub.c")
        File.write(stub_src, "int main(void) { return 0; }\n")
        sdk_path = sh("xcrun", "--sdk", "iphoneos", "--show-sdk-path").strip
        sh("xcrun", "clang",
           "-target", "arm64-apple-ios16.0",
           "-isysroot", sdk_path,
           stub_src, "-o", File.join(ios_app_dir, app_name))

        # 2. Generate iOS stub icon (Assets.car + loose PNGs) from project source
        source_icon = File.join(project_root, "TrainTimeWatch", "Assets.xcassets", "AppIcon.appiconset", "AppIcon-1024.png")
        if File.exist?(source_icon)
          sh("sips", "-z", "120", "120", source_icon, "--out", File.join(ios_app_dir, "AppIcon60x60@2x.png"))
          sh("sips", "-z", "180", "180", source_icon, "--out", File.join(ios_app_dir, "AppIcon60x60@3x.png"))

          # Compile Assets.car for the iOS stub so App Store Connect shows the icon
          ios_icon_dir = File.join(tmpdir, "ios_icon_assets", "Assets.xcassets", "AppIcon.appiconset")
          FileUtils.mkdir_p(ios_icon_dir)
          FileUtils.cp(source_icon, File.join(ios_icon_dir, "AppIcon1024x1024.png"))
          sh("sips", "-z", "120", "120", source_icon, "--out", File.join(ios_icon_dir, "AppIcon60x60@2x.png"))
          sh("sips", "-z", "180", "180", source_icon, "--out", File.join(ios_icon_dir, "AppIcon60x60@3x.png"))
          File.write(File.join(ios_icon_dir, "Contents.json"), <<~CJSON)
            {"images":[
              {"filename":"AppIcon60x60@2x.png","idiom":"iphone","scale":"2x","size":"60x60"},
              {"filename":"AppIcon60x60@3x.png","idiom":"iphone","scale":"3x","size":"60x60"},
              {"filename":"AppIcon1024x1024.png","idiom":"ios-marketing","scale":"1x","size":"1024x1024"}
            ],"info":{"author":"xcode","version":1}}
          CJSON

          ios_actool_out = File.join(tmpdir, "ios_actool_out")
          FileUtils.mkdir_p(ios_actool_out)
          sh("xcrun", "actool", "--compile", ios_actool_out,
             "--platform", "iphoneos",
             "--minimum-deployment-target", "16.0",
             "--app-icon", "AppIcon",
             "--output-partial-info-plist", File.join(tmpdir, "ios_partial.plist"),
             File.join(tmpdir, "ios_icon_assets", "Assets.xcassets"))

          ios_car = File.join(ios_actool_out, "Assets.car")
          if File.exist?(ios_car)
            FileUtils.cp(ios_car, File.join(ios_app_dir, "Assets.car"))
            UI.message("Compiled iOS stub Assets.car with app icon")
          end
        end

        # 3. Create iOS stub Info.plist
        sdk_version = sh("xcrun", "--sdk", "iphoneos", "--show-sdk-version").strip
        File.write(File.join(ios_app_dir, "Info.plist"), <<~PLIST)
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
            <key>CFBundleIdentifier</key>
            <string>#{bundle_id}</string>
            <key>CFBundleExecutable</key>
            <string>#{app_name}</string>
            <key>CFBundleName</key>
            <string>#{app_name}</string>
            <key>CFBundleVersion</key>
            <string>#{bundle_version}</string>
            <key>CFBundleShortVersionString</key>
            <string>#{short_version}</string>
            <key>CFBundleInfoDictionaryVersion</key>
            <string>6.0</string>
            <key>CFBundlePackageType</key>
            <string>APPL</string>
            <key>CFBundleSupportedPlatforms</key>
            <array>
              <string>iPhoneOS</string>
            </array>
            <key>UIDeviceFamily</key>
            <array>
              <integer>1</integer>
            </array>
            <key>DTPlatformName</key>
            <string>iphoneos</string>
            <key>DTSDKName</key>
            <string>iphoneos#{sdk_version}</string>
            <key>DTPlatformVersion</key>
            <string>#{sdk_version}</string>
            <key>MinimumOSVersion</key>
            <string>16.0</string>
            <key>LSRequiresIPhoneOS</key>
            <true/>
            <key>LSApplicationLaunchProhibited</key>
            <true/>
            <key>ITSWatchOnlyContainer</key>
            <true/>
            <key>UIRequiredDeviceCapabilities</key>
            <array>
              <string>arm64</string>
            </array>
            <key>WKWatchOnly</key>
            <true/>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
            <key>CFBundleIcons</key>
            <dict>
              <key>CFBundlePrimaryIcon</key>
              <dict>
                <key>CFBundleIconFiles</key>
                <array>
                  <string>AppIcon60x60</string>
                </array>
              </dict>
            </dict>
          </dict>
          </plist>
        PLIST

        # 4. Copy watchOS app into Watch/, change bundle ID to extend the stub's
        watch_dest = File.join(ios_app_dir, "Watch", "#{app_name}.app")
        FileUtils.mkdir_p(File.dirname(watch_dest))
        FileUtils.cp_r(watch_app_path, watch_dest)

        nested_plist = File.join(watch_dest, "Info.plist")
        sh("/usr/libexec/PlistBuddy", "-c", "Set :CFBundleIdentifier #{watch_bundle_id}", nested_plist)

        # Set DTSDKName to pre-watchOS 5 to bypass Apple's validation check
        # requiring Series 4 (44mm) icons. Xcode 26's actool cannot compile
        # appLauncher entries for 44mm/45mm/49mm subtypes into Assets.car,
        # but the validator checks DTSDKName to decide whether to require them.
        sh("/usr/libexec/PlistBuddy", "-c", "Set :DTSDKName watchos4.3", nested_plist)
        sh("/usr/libexec/PlistBuddy", "-c", "Set :DTPlatformVersion 4.3", nested_plist)

        # Generate loose icon PNGs for the nested watch app bundle.
        # Apple's upload validator checks for files matching *WxH@2x.png patterns.
        # The source icon PNGs are committed in the repo's asset catalog.
        if File.exist?(source_icon)
          loose_icons = {
            "AppIcon24x24@2x.png" => 48, "AppIcon27.5x27.5@2x.png" => 55,
            "AppIcon29x29@2x.png" => 58, "AppIcon29x29@3x.png" => 87,
            "AppIcon33x33@2x.png" => 66, "AppIcon40x40@2x.png" => 80,
            "AppIcon44x44@2x.png" => 88, "AppIcon46x46@2x.png" => 92,
            "AppIcon50x50@2x.png" => 100, "AppIcon51x51@2x.png" => 102,
            "AppIcon86x86@2x.png" => 172, "AppIcon98x98@2x.png" => 196,
            "AppIcon108x108@2x.png" => 216, "AppIcon117x117@2x.png" => 234,
            "AppIcon129x129@2x.png" => 258, "AppIcon1024x1024.png" => 1024
          }
          loose_icons.each do |name, px|
            sh("sips", "-z", px.to_s, px.to_s, source_icon, "--out", File.join(watch_dest, name))
          end
          UI.message("Generated #{loose_icons.size} loose icon PNGs in watch app bundle")
        end

        # CFBundleIconName and CFBundleIconFiles — validator expects these for watchOS in iOS stub
        sh("/usr/libexec/PlistBuddy", "-c", "Delete :CFBundleIconName", nested_plist) rescue nil
        sh("/usr/libexec/PlistBuddy", "-c", "Add :CFBundleIconName string AppIcon", nested_plist)

        sh("/usr/libexec/PlistBuddy", "-c", "Delete :CFBundleIcons:CFBundlePrimaryIcon:CFBundleIconFiles", nested_plist) rescue nil
        sh("/usr/libexec/PlistBuddy", "-c", "Add :CFBundleIcons:CFBundlePrimaryIcon:CFBundleIconFiles array", nested_plist)
        %w[AppIcon24x24 AppIcon27.5x27.5 AppIcon29x29 AppIcon33x33 AppIcon40x40
           AppIcon44x44 AppIcon46x46 AppIcon50x50 AppIcon51x51
           AppIcon86x86 AppIcon98x98 AppIcon108x108 AppIcon117x117 AppIcon129x129].each_with_index do |name, i|
          sh("/usr/libexec/PlistBuddy", "-c", "Add :CFBundleIcons:CFBundlePrimaryIcon:CFBundleIconFiles:#{i} string #{name}", nested_plist)
        end

        # 5. Embed provisioning profiles
        # Both the iOS stub and nested watch app need their own embedded.mobileprovision
        profile_dirs = [
          File.expand_path("~/Library/MobileDevice/Provisioning Profiles"),
          File.expand_path("~/Library/Developer/Xcode/UserData/Provisioning Profiles")
        ]
        all_profiles = profile_dirs.flat_map { |d| Dir["#{d}/*.mobileprovision"] }

        # Find profile for iOS stub (com.evanjt.traintime)
        stub_profile = all_profiles.find do |p|
          content = sh("security", "cms", "-D", "-i", p, log: false) rescue ""
          content.include?(bundle_id) && !content.include?(watch_bundle_id)
        end
        if stub_profile
          FileUtils.cp(stub_profile, File.join(ios_app_dir, "embedded.mobileprovision"))
          UI.message("Embedded iOS stub provisioning profile for #{bundle_id}")
        else
          UI.important("No matching provisioning profile found for #{bundle_id}")
        end

        # Find profile for nested watch app (com.evanjt.traintime.watchkitapp)
        watch_app_profile = all_profiles.find do |p|
          content = sh("security", "cms", "-D", "-i", p, log: false) rescue ""
          content.include?(watch_bundle_id)
        end
        if watch_app_profile
          FileUtils.cp(watch_app_profile, File.join(watch_dest, "embedded.mobileprovision"))
          UI.message("Embedded watch app provisioning profile for #{watch_bundle_id}")
        else
          UI.important("No matching provisioning profile found for #{watch_bundle_id}")
        end

        UI.message("Set watch app bundle ID to #{watch_bundle_id}")

        # Re-sign watch app with correct entitlements and profile
        watch_entitlements = File.join(tmpdir, "watch_entitlements.plist")
        File.write(watch_entitlements, <<~PLIST)
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
            <key>application-identifier</key>
            <string>#{team_id}.#{watch_bundle_id}</string>
            <key>com.apple.developer.team-identifier</key>
            <string>#{team_id}</string>
          </dict>
          </plist>
        PLIST

        sh("codesign", "--force", "--sign", "Apple Distribution",
           "--entitlements", watch_entitlements,
           "--timestamp=none",
           watch_dest)

        # 6. Sign iOS stub
        entitlements_path = File.join(tmpdir, "entitlements.plist")
        File.write(entitlements_path, <<~PLIST)
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
            <key>application-identifier</key>
            <string>#{team_id}.#{bundle_id}</string>
            <key>com.apple.developer.team-identifier</key>
            <string>#{team_id}</string>
          </dict>
          </plist>
        PLIST

        sh("codesign", "--force", "--sign", "Apple Distribution",
           "--entitlements", entitlements_path,
           "--timestamp=none",
           ios_app_dir)

        # Package IPA (no WatchKitSupport2 — standalone watchOS apps don't use it)
        sh("bash", "-c", "cd '#{tmpdir}' && zip -r -q '#{ipa_path}' Payload")
      end
    end

    UI.user_error!("IPA not created at #{ipa_path}") unless File.exist?(ipa_path)
    UI.success("Created IPA: #{ipa_path} (#{File.size(ipa_path)} bytes)")
  end

  desc "Upload to TestFlight (internal track)"
  lane :beta do |options|
    ipa_path = options[:ipa] || "artifacts/traintime.ipa"

    UI.user_error!("No IPA file specified. Use ipa:<path>") unless ipa_path
    UI.user_error!("IPA file not found: #{ipa_path}") unless File.exist?(ipa_path)

    UI.message("Uploading #{ipa_path} to TestFlight...")

    # Setup API key
    key_dir = File.expand_path("~/private_keys")
    FileUtils.mkdir_p(key_dir)
    require "base64"
    key_path = File.join(key_dir, "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
    File.write(key_path, Base64.decode64(ENV["ASC_API_KEY"]))

    # Extract metadata from IPA
    Dir.mktmpdir do |tmpdir|
      sh("unzip", "-q", ipa_path, "-d", tmpdir)
      app_path = Dir["#{tmpdir}/**/**.app"].first
      UI.user_error!("No .app found in IPA") unless app_path

      plist = File.join(app_path, "Info.plist")
      bundle_id = sh("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleIdentifier", plist).strip
      build_number = sh("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleVersion", plist).strip
      short_version = sh("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleShortVersionString", plist).strip

      UI.message("Uploading: bundle=#{bundle_id} version=#{short_version} build=#{build_number}")

      # Use altool --upload-package with explicit metadata (bypasses platform auto-detection)
      # Standalone watchOS apps are submitted as --type ios
      sh("xcrun", "altool", "--upload-package", ipa_path,
         "--type", "ios",
         "--apple-id", "6760388620",
         "--bundle-id", bundle_id,
         "--bundle-version", build_number,
         "--bundle-short-version-string", short_version,
         "--apiKey", ENV["ASC_KEY_ID"],
         "--apiIssuer", ENV["ASC_ISSUER_ID"])
    end

    UI.success("Uploaded to TestFlight!")
  end

  desc "Submit to App Store Review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: true
    )

    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
